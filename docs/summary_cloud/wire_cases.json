{
  "fixture_meta": {
    "schema_version": "summary-cloud-wire-cases-v1",
    "asset": "docs/summary_cloud/wire_cases.json",
    "source_contract": "docs/summary_api_contract.md (v0.3, 2026-09-30)",
    "purpose": "Offline fixtures for the frozen Phase 1 Summary Cloud HTTP contract. Contract-asset checks only, not production endpoint tests.",
    "evidence_tier": "fixture-only, offline, synthetic; no network call, no DeepSeek Summary API call, no runtime/product import",
    "token_numbers": "synthetic hand-chosen integers; python len() and these numbers never measure DeepSeek tokens",
    "error_code_policy": "fixture-level interpretation of contract sections 2-3: consent declaration defects map to consentRequired, schema/stage/cardinality/transport defects map to invalidInput/inputTooLong",
    "not_claimed": [
      "no production endpoint, adapter, Lambda or Flutter behavior is exercised",
      "no tokenizer or real DeepSeek token-count evidence",
      "no live provider smoke result",
      "no code-graph/index evidence"
    ],
    "checker": "python3 docs/summary_cloud/check_contract.py",
    "provider_fixture_shape": "provider_cases use a normalized fixture shape (text + mapped usage); not raw DeepSeek API responses."
  },
  "contract_decisions": {
    "provider_model": "deepseek-flash",
    "thinking": "disabled",
    "stream": false,
    "max_input_tokens_per_call": 16000,
    "max_output_tokens": {
      "direct": 256,
      "section": 128,
      "merge": 256
    },
    "chunk_count_range": [
      2,
      4
    ],
    "merge_calls_per_pipeline": 1,
    "max_generation_calls": 5,
    "automatic_generation_retry": false,
    "success_finish_reasons": [
      "stop"
    ],
    "consent_version": "summary-cloud-v1",
    "consent_accepted_required": true,
    "max_body_bytes_utf8": 262144,
    "stages": [
      "direct",
      "section",
      "merge"
    ],
    "stage_input_cardinality": {
      "direct": [
        1,
        1
      ],
      "section": [
        1,
        1
      ],
      "merge": [
        2,
        4
      ]
    },
    "request_allowed_fields": [
      "consent",
      "inputs",
      "stage"
    ],
    "consent_allowed_fields": [
      "accepted",
      "version"
    ],
    "forbidden_client_fields": [
      "ownerId",
      "model",
      "max_tokens",
      "systemPrompt",
      "providerUrl",
      "apiKey",
      "stream",
      "thinking"
    ]
  },
