# Copy to .env. Local-first development needs no AWS account.
NOTEFLOW_AUTH_MODE=local

# For cognito mode, use public JSON outputs from the intended dev deployment.
# Keep that file untracked, e.g. .env.amplify-outputs.json.
NOTEFLOW_AMPLIFY_OUTPUTS_FILE=
# Optional public endpoint overrides; otherwise read outputs.custom.
NOTEFLOW_SYNC_API=
NOTEFLOW_EVENT_HTTP=
NOTEFLOW_EVENT_SOCKET=

# Operator/backend authentication only. Choose one method:
# 1) AWS_PROFILE (recommended; existing CLI/SSO profile), OR
# 2) temporary access key + secret key, with session token when applicable.
# These values are never emitted into Flutter build defines.
AWS_PROFILE=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
